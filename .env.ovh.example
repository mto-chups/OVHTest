# Exemple de base MySQL managée OVH. Remplacer toutes les valeurs ci-dessous.
DB_HOST=mysql-xxxxxx.mysql.db.cloud.ovh.net
DB_PORT=20184
DB_USER=ovh_database_user
DB_PASSWORD=change-me
DB_NAME=deployment_test
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=15000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# En déploiement hors Compose, adapter aussi ces URLs au réseau utilisé.
REDIS_URL=redis://redis-host:6379
SERVER_URL=http://server:3000
MS1_URL=http://microservice-1:3001
