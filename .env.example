# Exécution locale avec `npm run dev:*` et WAMP sur la même machine.
SERVER_PORT=3100
MS1_PORT=3001
SERVER_URL=http://127.0.0.1:3100
MS1_URL=http://127.0.0.1:3001

# WAMP / MySQL ou MariaDB local. Créer cette base une première fois dans phpMyAdmin.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=deployment_test
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis doit être démarré séparément en exécution npm locale.
REDIS_URL=redis://127.0.0.1:6379
